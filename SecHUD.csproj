<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>SecHUD</RootNamespace>
    <AssemblyName>SecHUD</AssemblyName>
    <Version>0.8.4</Version>
    <Authors>Ty</Authors>
    <Product>SecHUD</Product>
    <Description>Home network security monitor</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SecHUD.ico</ApplicationIcon>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests are their own project (tests\SecHUD.Tests.csproj). -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- So is the installer (setup\SecHUD.Setup.csproj). -->
    <Compile Remove="setup\**" />
    <Page Remove="setup\**" />
    <None Remove="setup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public IEEE list of which maker owns which block of MAC addresses, packed into the exe. -->
    <EmbeddedResource Include="Data\oui.gz" LogicalName="SecHUD.oui.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- All of these ship with Windows as part of .NET Framework 4.8. No NuGet packages. -->
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
