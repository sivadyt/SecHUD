<Window x:Class="SecHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecHUD"
        Width="1360" Height="780" MinWidth="1120" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource HudFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- No Windows title bar: the app draws its own, and the edges still resize the window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One label/value line -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueText}" Margin="10,0,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="SECHUD" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="//  NETWORK WATCH" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource HazardButton}" Content="{Binding UpdateLabel}" Command="{Binding OpenUpdateCommand}"
                            VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding UpdateNotes}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M0,8 L11,8" StrokeThickness="1.5" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                        <Path Data="M0.5,0.5 L10.5,0.5 L10.5,10.5 L0.5,10.5 Z" StrokeThickness="1.5" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Click="Close_Click" ToolTip="Hide to tray (keeps watching)">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" StrokeThickness="1.5" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="344"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Left: status and checks ===== -->
                <Border Grid.Column="0" BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Level}" Style="{StaticResource LevelText}"/>
                            <TextBlock Text="{Binding Ticker}" Style="{StaticResource TickerText}" MinHeight="32" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding LastScan}" Style="{StaticResource HeaderText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource HeaderText}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       ToolTip="Live watch: Windows tells SecHUD the moment a startup entry, service, task, account, port, firewall or antivirus setting changes, and this PC is re-checked right away."/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource HudButton}" Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" MinWidth="124"/>
                                <Button Style="{StaticResource HudButton}" Content="APPROVE ALL" Command="{Binding ApproveAllCommand}" Margin="10,0,0,0"
                                        ToolTip="Accept everything currently flagged as normal. To accept one thing only, use the Approve or Dismiss button on its row."/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,18,0,12"/>
                            <TextBlock Text="THIS PC" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding PcRows}" ItemTemplate="{StaticResource RowTemplate}"/>

                            <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,12"/>
                            <TextBlock Text="NETWORK" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding NetRows}" ItemTemplate="{StaticResource RowTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== Right: tabs ===== -->
                <Grid Grid.Column="1" Margin="22,14,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <RadioButton x:Name="TabDevices" GroupName="Tabs" IsChecked="True" Style="{StaticResource TabButton}" Content="{Binding DeviceSummary}"/>
                        <RadioButton x:Name="TabPorts" GroupName="Tabs" Style="{StaticResource TabButton}" Content="{Binding PortSummary}"/>
                        <RadioButton x:Name="TabAutoruns" GroupName="Tabs" Style="{StaticResource TabButton}" Content="{Binding AutorunSummary}"/>
                        <RadioButton x:Name="TabRouter" GroupName="Tabs" Style="{StaticResource TabButton}" Content="ROUTER" Visibility="{Binding ShowRouterTab, Converter={StaticResource BoolToVis}}"/>
                        <RadioButton x:Name="TabProxmox" GroupName="Tabs" Style="{StaticResource TabButton}" Content="PROXMOX" Visibility="{Binding ShowProxmoxTab, Converter={StaticResource BoolToVis}}"/>
                        <RadioButton x:Name="TabEvents" GroupName="Tabs" Style="{StaticResource TabButton}" Content="{Binding EventSummary}"/>
                        <RadioButton x:Name="TabLogs" GroupName="Tabs" Style="{StaticResource TabButton}" Content="{Binding LogSummary}" Visibility="{Binding ShowLogsTab, Converter={StaticResource BoolToVis}}"/>
                        <RadioButton x:Name="TabHistory" GroupName="Tabs" Style="{StaticResource TabButton}" Content="HISTORY"/>
                        <RadioButton x:Name="TabSettings" GroupName="Tabs" Style="{StaticResource TabButton}" Content="SETTINGS"/>
                    </StackPanel>

                    <!-- Devices -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabDevices, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*" MinWidth="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="108"/><ColumnDefinition Width="140"/><ColumnDefinition Width="92"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STATUS" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="NAME (CLICK TO EDIT)" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="MADE BY" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="3" Text="ADDRESS" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="4" Text="MAC" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="5" Text="LAST SEEN" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="34">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*" MinWidth="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="108"/><ColumnDefinition Width="140"/><ColumnDefinition Width="92"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Status}" Style="{StaticResource DeviceStatusText}"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource NameBox}" MaxLength="40" Margin="0,0,18,0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="NameBox_KeyDown"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Maker}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" ToolTip="Worked out from the first half of the MAC address. PRIVATE ADDRESS means the device made up its own address, which phones, tablets and laptops do for privacy."/>
                                                <TextBlock Grid.Column="3" Text="{Binding Ip}" Style="{StaticResource CellText}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Mac}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding LastSeen}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Button Style="{StaticResource HazardButton}" Content="APPROVE" Margin="0,0,8,0" Command="{Binding ApproveCommand}" Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource WatchButton}" Content="{Binding WatchLabel}" Margin="0,0,8,0" Command="{Binding WatchCommand}" Visibility="{Binding IsApproved, Converter={StaticResource BoolToVis}}" ToolTip="Alert me when this device goes offline. Best for things that are always on, such as a camera, doorbell or NAS. Phones go quiet whenever they sleep."/>
                                                    <Button Style="{StaticResource SmallButton}" Content="PORTS" Command="{Binding ScanPortsCommand}" ToolTip="Check which common services this device is offering"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Text="{Binding OpenPorts}" Style="{StaticResource HintText}" Foreground="{StaticResource CyanBrush}" Margin="0,0,10,8" Visibility="{Binding HasOpenPorts, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Ports -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabPorts, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TCP PORT" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="LISTENING PROCESS" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Ports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="32">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition MinHeight="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Note}" Style="{StaticResource TrustText}" Margin="0,0,14,8"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ProgramPath}"/>
                                                <TextBlock Grid.Column="0" Text="{Binding Port}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Process}" Style="{StaticResource CellText}" ToolTip="{Binding ProgramPath}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Flag}" Style="{StaticResource PortFlagText}" Margin="0,0,10,0"/>
                                                    <Button Style="{StaticResource HazardButton}" Content="APPROVE" Command="{Binding ApproveCommand}" ToolTip="This port is expected. Stop flagging it." Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource HazardButton}" Content="IGNORE PROGRAM" Margin="8,0,0,0" Command="{Binding TrustCommand}" ToolTip="Stop flagging every port this program opens, now and later. For programs such as a media server or a game launcher that use different ports each time. You are asked first, and you can undo it in Settings." Visibility="{Binding CanTrustFlagged, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource QuietButton}" Content="IGNORE PROGRAM" Command="{Binding TrustCommand}" ToolTip="Never flag ports opened by this program. You are asked first, and you can undo it in Settings under Ignored programs." Visibility="{Binding CanTrustQuiet, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Autoruns -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabAutoruns, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Denied items that can be put back -->
                        <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVis}}">
                            <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="DENIED ITEMS (CAN BE PUT BACK)" Style="{StaticResource SectionTitle}"/>
                            <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Removed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                                <Grid MinHeight="32">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="84"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource CellText}" Margin="0,0,14,0" ToolTip="{Binding Name}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Command}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" ToolTip="{Binding Command}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource SmallButton}" Content="RESTORE" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Command="{Binding RestoreCommand}" ToolTip="Put this startup item back into Windows exactly as it was. You are asked first."/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Grid.Row="0">
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="KIND" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="COMMAND" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Autoruns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="32">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="232"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition MinHeight="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note}" Style="{StaticResource TrustText}" Margin="0,0,14,8"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="What SecHUD could find out about the program behind this item. A signature shows who made a program, not that it is good, so use it as one clue."/>
                                                <TextBlock Grid.Column="0" Text="{Binding Kind}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CellText}" Margin="0,0,14,0" ToolTip="{Binding Name}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Command}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0" ToolTip="{Binding Command}"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Flag}" Style="{StaticResource PortFlagText}" Margin="0,0,10,0"/>
                                                    <Button Style="{StaticResource HazardButton}" Content="APPROVE" Command="{Binding ApproveCommand}" ToolTip="This startup item is expected. Stop flagging it." Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource DenyButton}" Content="DENY" Margin="8,0,0,0" Command="{Binding DenyCommand}" ToolTip="Remove this startup item from Windows. You are asked first, and a record is kept so it can be put back." Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Router -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabRouter, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding RouterStatus}" Style="{StaticResource StatusLine}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FROM THE INTERNET" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="GOES TO" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="DESCRIPTION" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Forwards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="32">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Port}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Target}" Style="{StaticResource CellText}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,14,0"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Flag}" Style="{StaticResource PortFlagText}" Margin="0,0,10,0"/>
                                                    <Button Style="{StaticResource HazardButton}" Content="APPROVE" Command="{Binding ApproveCommand}" ToolTip="This one port forward is expected. Stop flagging it." Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource HazardButton}" Content="IGNORE" Margin="8,0,0,0" Command="{Binding IgnoreCommand}" ToolTip="Stop flagging every forward with this name, now and later. For a program that asks for a different port each time. You are asked first, and you can undo it in Settings." Visibility="{Binding CanIgnoreFlagged, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource QuietButton}" Content="IGNORE" Margin="8,0,0,0" Command="{Binding IgnoreCommand}" ToolTip="Stop flagging every forward with this name, now and later. You are asked first, and you can undo it in Settings." Visibility="{Binding CanIgnoreQuiet, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource DenyButton}" Content="DENY" Margin="8,0,0,0" Command="{Binding DenyCommand}" ToolTip="Ask the router to close this port, so it is no longer reachable from the internet. You are asked first."/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Proxmox -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabProxmox, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding ProxmoxStatus}" Style="{StaticResource StatusLine}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="NAME" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="4" Text="CPU" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="5" Text="MEMORY" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Guests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="30">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource CellText}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource GuestStatusText}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Cpu}" Style="{StaticResource CellText}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Memory}" Style="{StaticResource CellText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Events -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabEvents, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SEARCH" Style="{StaticResource HeaderText}" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding EventFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="ATT&amp;CK" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="3" Text="EVENT" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="32">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource EventText}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Technique}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource EventText}" Margin="0,0,10,0" ToolTip="{Binding Message}"/>
                                                <Button Grid.Column="4" Style="{StaticResource HazardButton}" Content="DISMISS" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Command="{Binding DismissCommand}" ToolTip="You have looked at this detection. Stop it holding the status at ELEVATED." Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Logs -->
                    <Grid Grid.Row="1" Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=TabLogs, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding SyslogStatus}" Style="{StaticResource StatusLine}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SEARCH" Style="{StaticResource HeaderText}" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="1" Height="26">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="1" Text="SOURCE" Style="{StaticResource HeaderText}"/><TextBlock Grid.Column="2" Text="MESSAGE" Style="{StaticResource HeaderText}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="30">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource EventText}" ToolTip="{Binding Text}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- History -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsChecked, ElementName=TabHistory, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                                <TextBlock Text="DEVICES ONLINE" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding DeviceBars}" Height="72">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="26" Margin="0,0,4,0" Background="Transparent" ToolTip="{Binding Tip}">
                                                <Rectangle Height="{Binding Height}" Style="{StaticResource BarFill}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Height="1" Width="716" HorizontalAlignment="Left" Fill="{StaticResource AccentDimBrush}"/>
                                <Grid Width="716" HorizontalAlignment="Left" Margin="0,3,0,18">
                                    <TextBlock Text="24 HOURS AGO" Style="{StaticResource HeaderText}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="MOST SEEN EACH HOUR" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NOW" Style="{StaticResource HeaderText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="ALERTS" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding AlertBars}" Height="72">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="26" Margin="0,0,4,0" Background="Transparent" ToolTip="{Binding Tip}">
                                                <Rectangle Height="{Binding Height}" Style="{StaticResource BarFill}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Height="1" Width="716" HorizontalAlignment="Left" Fill="{StaticResource AccentDimBrush}"/>
                                <Grid Width="716" HorizontalAlignment="Left" Margin="0,3,0,18">
                                    <TextBlock Text="24 HOURS AGO" Style="{StaticResource HeaderText}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="ALERTS RAISED EACH HOUR" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NOW" Style="{StaticResource HeaderText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding StatusBars}" Height="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="26" Margin="0,0,4,0" Background="Transparent" ToolTip="{Binding Tip}">
                                                <Rectangle Height="{Binding Height}" Style="{StaticResource BarFill}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Rectangle Height="1" Width="716" HorizontalAlignment="Left" Fill="{StaticResource AccentDimBrush}"/>
                                <Grid Width="716" HorizontalAlignment="Left" Margin="0,3,0,18">
                                    <TextBlock Text="24 HOURS AGO" Style="{StaticResource HeaderText}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="YELLOW = ELEVATED THAT HOUR" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="NOW" Style="{StaticResource HeaderText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="HOST UPTIME, LAST 24 HOURS" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding UptimeRows}" ItemTemplate="{StaticResource RowTemplate}" Width="360" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsChecked, ElementName=TabSettings, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,16,0" MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="SCANNING" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scan every (seconds)" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="110" HorizontalAlignment="Left" Text="{Binding SetScanSeconds}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Alert at this many failed logins" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="110" HorizontalAlignment="Left" Text="{Binding SetLoginThreshold}"/>
                                </Grid>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetLiveWatch}" Content="Live watch: check this PC the moment something on it changes"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="26,-4,0,10" Text="Windows tells SecHUD when a startup entry, service, scheduled task, account, listening port, firewall or antivirus setting changes, and the alert arrives within a second or two. With this off, changes are found on the next scan. Devices joining the network are always found by the scan."/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetScanLan}" Content="Sweep the LAN for devices"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetGuestPrivate}" Content="Treat phones with a private address as guests (no alert)"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="26,-4,0,10" Text="Most phones and tablets make up their own address for each network. With this on, a new one is listed as GUEST and does not raise an alert, and it drops off the list a week after it was last seen. Handy if you often have visitors. Leave it off if you want to hear about every new device: a stranger's phone looks exactly the same."/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetWatchAutoruns}" Content="Watch autoruns (run keys, startup, services, tasks)"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetWatchRouter}" Content="Ask the router which ports it forwards (UPnP). Shows the Router tab."/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetNotify}" Content="Show Windows notifications for alerts"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetStartWithWindows}" Content="Start with Windows (hidden in the tray)"/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="DETECTION RULES" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetWatchEvents}" Content="Run detection rules on Windows events"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="EDIT MY RULES" Command="{Binding OpenRulesCommand}"/>
                                    <TextBlock Text="{Binding RulesInfo}" Style="{StaticResource StatusLine}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="Your own rules live in rules.json: which log, which event ID, optional text it must contain, the ATT&amp;CK technique, a severity (high, medium or info) and the message. Set enabled to true. Changes apply on the next scan."/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="WI-FI TWIN CHECK" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetWatchWifi}" Content="Alert when a new access point uses my Wi-Fi name"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="My Wi-Fi name" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="260" HorizontalAlignment="Left" Text="{Binding SetHomeWifiName}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="230,0,0,0" Text="Needed when this PC is on a cable. Leave blank to use whichever Wi-Fi it is connected to. A mesh or extender shows up as extra access points: approve them once."/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="DISCORD ALERTS" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Webhook address: " Style="{StaticResource FormLabel}"/>
                                        <TextBlock Text="{Binding DiscordState}" Style="{StaticResource FormLabel}" Foreground="{StaticResource CyanBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding SetDiscordWebhook}"/>
                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="SEND TEST" Margin="10,0,0,0" Command="{Binding TestDiscordCommand}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="230,4,0,0" Text="Leave blank to keep the saved one. Type NONE to remove it. It is stored encrypted."/>
                                <CheckBox Style="{StaticResource HudCheck}" Margin="0,12,0,8" IsChecked="{Binding SetWeeklySummary}" Content="Send a weekly summary, so a quiet week still shows SecHUD is working"/>
                                <StackPanel Orientation="Horizontal" Margin="26,0,0,4">
                                    <Button Style="{StaticResource SmallButton}" Content="SEND SUMMARY NOW" Command="{Binding SendSummaryCommand}" ToolTip="Sends this week's summary to Discord straight away, so you can see what it looks like."/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource HudCheck}" Margin="0,12,0,8" IsChecked="{Binding SetQuietHours}" Content="Quiet hours: hold ordinary Discord alerts and send one summary afterwards"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Quiet from / until" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="80" Text="{Binding SetQuietStart}"/>
                                    <TextBlock Grid.Column="2" Text="until" Style="{StaticResource FormLabel}" Margin="12,0,12,0"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource InputBox}" Width="80" Text="{Binding SetQuietEnd}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="230,4,0,0" Text="24-hour times, for example 23:00 until 07:00. Urgent alerts still arrive straight away: protection switched off, a new account or administrator, cleared logs, malware, and tampering with the gateway, DNS or Wi-Fi."/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="PROXMOX (OPTIONAL)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" Text="Only for people who run a Proxmox server. The Proxmox tab appears once a host is filled in. Clear the host to hide it again."/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Host or IP address" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="260" HorizontalAlignment="Left" Text="{Binding SetProxmoxHost}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="API token ID" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="260" HorizontalAlignment="Left" Text="{Binding SetProxmoxTokenId}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="API token secret: " Style="{StaticResource FormLabel}"/>
                                        <TextBlock Text="{Binding ProxmoxSecretState}" Style="{StaticResource FormLabel}" Foreground="{StaticResource CyanBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding SetProxmoxSecret}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="230,4,0,0" Text="Create the token in Proxmox under Datacenter, Permissions, API Tokens, and give it the PVEAuditor role so it can only read. The token ID looks like root@pam!sechud. Blank keeps the saved secret, NONE removes it."/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="SYSLOG INTAKE" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetSyslogEnabled}" Content="Receive syslog from other devices. Shows the Logs tab."/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="UDP port" Style="{StaticResource FormLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Width="110" HorizontalAlignment="Left" Text="{Binding SetSyslogPort}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="230,0,0,0" Text="Windows will ask once whether to let SecHUD through the firewall. Allow it on private networks only."/>
                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="UPDATES" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetCheckUpdates}" Content="Check GitHub for a new version once a day"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="CHECK NOW" Command="{Binding CheckUpdatesCommand}"/>
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource StatusLine}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="The check only asks GitHub for the latest version number and sends nothing about you or your network. When a new version is out, a yellow button appears at the top. Click it and SecHUD downloads the update, checks it, and restarts by itself. Nothing is installed until you click."/>

                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="IGNORED PROGRAMS" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" Text="Some programs, such as a media server or a game launcher, open different ports every time they run, so approving ports one at a time never ends. Ignore the program and none of its ports are flagged again. Only the exact file is ignored: a program with the same name in another folder is still flagged. These take effect straight away, with no need to press Save."/>

                                <TextBlock Text="IGNORED NOW" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
                                <TextBlock Text="NONE YET" Style="{StaticResource StatusLine}" Margin="0,0,0,6" Visibility="{Binding NoIgnoredPrograms, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding IgnoredPrograms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                                <Grid MinHeight="32">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}" Margin="0,0,12,0" ToolTip="{Binding Path}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" ToolTip="{Binding Path}"/>
                                                    <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="STOP IGNORING" VerticalAlignment="Center" Command="{Binding ActionCommand}" ToolTip="Flag this program's new ports again, like any other program."/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding HasIgnoredForwards, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="IGNORED ROUTER FORWARDS" Style="{StaticResource HeaderText}" Margin="0,16,0,4"/>
                                    <ItemsControl ItemsSource="{Binding IgnoredForwardRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                                    <Grid MinHeight="32">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" Foreground="{StaticResource CyanBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="STOP IGNORING" VerticalAlignment="Center" Command="{Binding ActionCommand}" ToolTip="Flag new forwards with this name again."/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="ADD A PROGRAM..." Command="{Binding AddProgramCommand}" ToolTip="Browse to any program on this PC and ignore it, even if it is not running right now."/>
                                    <TextBlock Text="FOR ONE THAT IS NOT IN THE LIST BELOW" Style="{StaticResource HeaderText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="PROGRAMS WITH A PORT OPEN RIGHT NOW" Style="{StaticResource HeaderText}" Margin="0,16,0,4"/>
                                <TextBlock Text="NOTHING TO SHOW YET. WAIT FOR THE FIRST SCAN." Style="{StaticResource StatusLine}" Margin="0,0,0,6" Visibility="{Binding NoListeningPrograms, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding ListeningPrograms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AccentFaintBrush}" BorderThickness="0,1,0,0">
                                                <Grid MinHeight="32">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" Margin="0,0,12,0" ToolTip="{Binding Path}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CellText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" ToolTip="{Binding Path}"/>
                                                    <Button Grid.Column="2" Style="{StaticResource HazardButton}" Content="IGNORE" VerticalAlignment="Center" Command="{Binding ActionCommand}" ToolTip="Never flag ports opened by this program. You are asked first, and shown who signed it."/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,14,0,14"/>
                                <TextBlock Text="WATCHED HOSTS" Style="{StaticResource SectionTitle}"/>
                                <TextBox Style="{StaticResource MultiInputBox}" Text="{Binding SetWatchedHosts}"/>
                                <TextBlock Style="{StaticResource HintText}" Text="One per line: name, host, port, tls or plain. Example: nas, 192.168.1.5, 22, plain"/>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,20">
                                    <Button Style="{StaticResource HudButton}" Content="SAVE SETTINGS" Command="{Binding SaveSettingsCommand}"/>
                                    <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource StatusLine}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= FOOTER ================= -->
            <Grid Grid.Row="2" Background="{StaticResource PanelBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="DATA" Style="{StaticResource HeaderText}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource HeaderText}" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding FooterNote}" Style="{StaticResource HeaderText}" Foreground="{StaticResource CyanBrush}" Margin="24,0,0,0" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource LinkButton}" Content="EXPORT REPORT" Command="{Binding ExportReportCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="EDIT CONFIG FILE" Command="{Binding OpenConfigCommand}"/>
                    <Button Style="{StaticResource LinkButton}" Content="OPEN DATA FOLDER" Command="{Binding OpenFolderCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ================= FIRST-RUN WELCOME ================= -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource BgBrush}"
                  Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="680" Margin="30,34,30,30" HorizontalAlignment="Center">
                        <TextBlock Text="WELCOME TO SECHUD" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,8,0,18"
                                   Text="SecHUD watches this PC and your home network and tells you when something changes. Three things to know before it starts:"/>

                        <TextBlock Text="1  THE FIRST SCAN IS YOUR BASELINE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="0,0,0,14"
                                   Text="Whatever it finds on the first scan is treated as normal: the devices on your network, the programs that start with Windows, the open ports, the user accounts. Start it when only your own devices are connected."/>

                        <TextBlock Text="2  AFTER THAT, ANYTHING NEW IS FLAGGED" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="0,0,0,14"
                                   Text="A new device, startup program, account or port shows up marked NEW and the status turns to ELEVATED. If it is yours, press Approve. If it is not, that is the thing to look into. Changes on this PC are caught within seconds, new devices on the next scan."/>

                        <TextBlock Text="3  YOUR DATA STAYS ON THIS PC" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="0,0,0,18"
                                   Text="Everything is kept in a folder on this PC. The only things that go out are the Discord alerts you set up yourself and a once-a-day check for a new version."/>

                        <Rectangle Height="1" Fill="{StaticResource AccentDimBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="OPTIONAL, AND YOU CAN CHANGE ALL OF IT LATER IN SETTINGS" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="My Wi-Fi name" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding SetHomeWifiName}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="170,4,0,12" Text="Lets SecHUD warn you when a copycat access point starts using your Wi-Fi name. Leave it blank if this PC is on Wi-Fi: it will use the network it is connected to."/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discord webhook" Style="{StaticResource FormLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding SetDiscordWebhook}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="170,4,0,12" Text="Sends alerts to your phone. In Discord, on a server you own: Server Settings, Integrations, Webhooks, New Webhook, Copy Webhook URL, then paste it here."/>
                        <CheckBox Style="{StaticResource HudCheck}" IsChecked="{Binding SetStartWithWindows}" Content="Start with Windows, hidden in the tray"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource HudButton}" Content="START WATCHING" Command="{Binding FinishWelcomeCommand}" MinWidth="170"/>
                            <TextBlock Text="{Binding WelcomeStatus}" Style="{StaticResource StatusLine}" Foreground="{StaticResource HazardBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
